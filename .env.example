# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=groove
POSTGRES_PASSWORD=change-me
POSTGRES_DB=groove

# --- API ---
# Built from the values above by docker-compose; override only for running the API outside Docker.
DATABASE_URL=postgresql+psycopg://groove:change-me@localhost:5432/groove
# Key that encrypts stored Discogs tokens (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# --- Discogs (application credentials, from https://www.discogs.com/settings/developers) ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# Public URL of this app, used for the Discogs OAuth callback
PUBLIC_BASE_URL=http://localhost:8080
# Swagger UI at /api/docs (off by default in docker-compose; turn on only for debugging)
API_DOCS_ENABLED=

# --- Deployment (VPS) ---
# Domain served by Caddy with automatic HTTPS (then HTTP_PORT=80 and HTTPS_PORT=443)
SITE_ADDRESS=
HTTP_PORT=
HTTPS_PORT=
# Images published by GitHub Actions; empty = built locally. APP_VERSION is set by the deploy.
API_IMAGE=
WEB_IMAGE=
APP_VERSION=
